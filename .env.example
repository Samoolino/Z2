# Z2 defaults to observe-only. Never set live trading true in the initial deployment.
Z2_MODE=observe_only
Z2_LIVE_TRADING_ENABLED=false
Z2_API_HOST=0.0.0.0
Z2_API_PORT=8000

# Local Docker Compose dependencies. Change the password before starting.
POSTGRES_DB=z2
POSTGRES_USER=z2
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql://z2:change-this-local-password@postgres:5432/z2
REDIS_URL=redis://redis:6379/0
NATS_URL=nats://nats:4222

# Single-operator local CCXT test only. Do not commit real values.
CCXT_EXCHANGE_ID=binance
CCXT_MARKET_TYPE=spot
CCXT_SANDBOX=true
CCXT_API_KEY=
CCXT_SECRET=
CCXT_PASSWORD=
CCXT_UID=

# Reference data providers: keep keys server-side and respect provider quotas.
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=

# Arbitrage Gap: no public programmatic feed has been established.
# Only configure after receiving a vendor-approved API/feed and written permission.
ARBITRAGEGAP_API_BASE_URL=
ARBITRAGEGAP_API_TOKEN=

# Optional existing service adapters (keep credentials server-side).
NU_ARB_CONTROL_API_URL=
NU_ARB_SERVICE_TOKEN=
HUMMINGBOT_API_URL=
HUMMINGBOT_API_TOKEN=
