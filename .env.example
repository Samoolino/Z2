# Never commit populated secrets. Use Replit Deployment Secrets or a managed secret store.
Z2_MODE=observe_only
Z2_LIVE_TRADING_ENABLED=false
Z2_API_HOST=0.0.0.0
Z2_API_PORT=8000

# External data providers: add credentials only to server-side secret storage.
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=

# Integrations are disabled until endpoint, auth and evidence are configured.
ARBITRAGEGAP_API_BASE_URL=
ARBITRAGEGAP_API_TOKEN=
NU_ARB_CONTROL_API_URL=
NU_ARB_SERVICE_TOKEN=
HUMMINGBOT_API_URL=
HUMMINGBOT_API_TOKEN=
